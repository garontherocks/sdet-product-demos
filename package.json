{
  "name": "sdet-product-demos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node apps/storefront/server.mjs",
    "test": "playwright test",
    "test:bootstrap": "playwright test tests/bootstrap.spec.ts",
    "test:rescue": "node scripts/run-rescue-demo.mjs",
    "validate:rescue": "node scripts/validate-rescue-metrics.mjs",
    "test:migration": "playwright test tests/migration/migrated.spec.ts",
    "validate:migration": "node scripts/validate-migration-demo.mjs",
    "metrics": "node scripts/summarize-metrics.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
